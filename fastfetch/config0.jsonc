{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "/HDD/Icons/Gentoo/Ripples-larry.png",
        "type": "kitty-direct",
        "height": 15,
        "width": 30,
        "padding": {
            "top": 5,
            "left": 3
        }
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;5;13m╭────────────────────────────────────────────────────────────────╮"
        },
        {
            "type": "host",
            "key": "\u001b[38;5;13m🐂  \u001b[38;5;14mPC\u001b[0m"
        },
        {
            "type": "cpu",
            "key": "\u001b[38;5;10m│ 🔋\u001b[38;5;14m CPU\u001b[0m",
            "showPeCoreCount": true
        },
        {
            "type": "gpu",
            "key": "\u001b[38;5;10m│ 🚀\u001b[38;5;14m GPU\u001b[0m"
        },
        {
            "type": "memory",
            "key": "\u001b[38;5;10m│ 🧠\u001b[38;5;14m RAM\u001b[0m"
        },
        {
            "type": "disk",
            "key": "\u001b[38;5;2m└ 📦\u001b[38;5;10m Disk\u001b[0m"
        },
        {
            "type": "custom",
            "format": "\u001b[38;5;13m╰────────────────────────────────────────────────────────────────╯"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;5;13m╭────────────────────────────────────────────────────────────────╮"
        },
        {
            "type": "os",
            "key": "\u001b[38;5;11m🧬 \u001b[38;5;10mOS\u001b[0m"
        },
        {
            "type": "kernel",
            "key": "\u001b[38;5;11m│ ⚙️ \u001b[38;5;10mKernel\u001b[0m"
        },
        {
            "type": "packages",
            "key": "\u001b[38;5;11m│ 📚 \u001b[38;5;10mPkgs\u001b[0m"
        },
        {
            "type": "shell",
            "key": "\u001b[38;5;11m└ 🧙 \u001b[38;5;10mShell\u001b[0m"
        },
        {
            "type": "custom",
            "format": "\u001b[38;5;13m╰────────────────────────────────────────────────────────────────╯"
        },
        "break",
        {
            "type": "de",
            "key": "\u001b[38;5;6m🪟 \u001b[38;5;14mDE\u001b[0m"
        },
        {
            "type": "lm",
            "key": "\u001b[38;5;6m│ 🎨 \u001b[38;5;14mLM\u001b[0m"
        },
        {
            "type": "wm",
            "key": "\u001b[38;5;6m│ 🧱 \u001b[38;5;14mWM\u001b[0m"
        },
        {
            "type": "wmtheme",
            "key": "\u001b[38;5;6m│ 🧵 \u001b[38;5;14mTheme\u001b[0m"
        },
        {
            "type": "gpu",
            "key": "\u001b[38;5;5m└ 🖥️\u001b[38;5;13m GPU Info\u001b[0m",
            "format": "{3}"
        },
        {
            "type": "custom",
            "format": "\u001b[38;5;13m╰────────────────────────────────────────────────────────────────╯"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;5;13m╭────────────────────────────────────────────────────────────────╮"
        },
        {
            "type": "command",
            "key": "😂 Dad Joke",
            "keyColor": "13",
            "text": "curl -s -H \"Accept: text/plain\" https://icanhazdadjoke.com/"
        },
        {
            "type": "custom",
            "format": "\u001b[38;5;13m╰────────────────────────────────────────────────────────────────╯"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;5;13m╭────────────────────────────────────────────────────────────────╮"
        },
        {
            "type": "command",
            "key": "🏅 Distro Hop Sobriety",
            "keyColor": "11",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "uptime",
            "key": "⏱️ Uptime",
            "keyColor": "11"
        },
        {
            "type": "custom",
            "format": "\u001b[38;5;13m╰────────────────────────────────────────────────────────────────╯"
        },
        "break"
    ]
}
